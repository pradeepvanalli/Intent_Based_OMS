{
  // Intent OMS in GitHub Codespaces or VS Code Dev Containers: Temurin JDK 21, Maven, Node 22 and Docker (for the
  // compose Postgres/Redis and the Testcontainers tests). "Code → Codespaces → Create codespace on main" is enough:
  // the first create builds the UI and the backend (~6-8 min); every start runs scripts/bootstrap.sh, which starts
  // Postgres + Redis, the service on :8080 and seeds the demo tenants. Click the "Intent OMS" port when it appears.
  //
  // Machine size: the 2-core / 8 GB Codespace works (memory need is ~5 GB: JVM 2 GB, Maven build 2 GB, Postgres 0.5 GB,
  // Docker 0.5 GB); pick 4-core / 16 GB for a faster first build. hostRequirements below asks for 8 GB.
  "name": "Intent OMS",
  "build": { "dockerfile": "Dockerfile" },
  "hostRequirements": { "cpus": 2, "memory": "8gb", "storage": "32gb" },

  "features": {
    "ghcr.io/devcontainers/features/java:1": { "version": "21", "jdkDistro": "tem", "installMaven": "true", "installGradle": "false" },
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    "ghcr.io/devcontainers/features/docker-in-docker:2": { "version": "latest", "moby": true, "dockerDashComposeVersion": "v2" },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  "forwardPorts": [8080, 5173, 5440],
  "portsAttributes": {
    "8080": { "label": "Intent OMS", "onAutoForward": "notify", "protocol": "http" },
    "5173": { "label": "Vite dev server (UI hot reload)", "onAutoForward": "silent", "protocol": "http" },
    "5440": { "label": "PostgreSQL", "onAutoForward": "silent" }
  },
  "otherPortsAttributes": { "onAutoForward": "ignore" },

  "containerEnv": {
    "JAVA_TOOL_OPTIONS": "-XX:MaxRAMPercentage=40",
    "MAVEN_OPTS": "-Xmx1536m -Dmaven.artifact.threads=8",
    "NODE_OPTIONS": "--max-old-space-size=1536",
    "OMS_DEMO_TENANTS": "demo,retail,electronics,apparel",
    "CODESPACES_NOTE": "see .devcontainer/devcontainer.json"
  },
  "remoteEnv": { "PATH": "${containerEnv:PATH}:${containerWorkspaceFolder}/scripts" },

  "onCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",
  "waitFor": "onCreateCommand",

  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vmware.vscode-boot-dev-pack",
        "redhat.vscode-yaml",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-azuretools.vscode-docker",
        "humao.rest-client",
        "bierner.markdown-mermaid",
        "GitHub.vscode-pull-request-github"
      ],
      "settings": {
        "java.configuration.updateBuildConfiguration": "automatic",
        "java.import.maven.enabled": true,
        "java.compile.nullAnalysis.mode": "disabled",
        "java.jdt.ls.vmargs": "-Xmx1G",
        "files.exclude": { "**/target": true, "**/node_modules": true },
        "search.exclude": { "**/target": true, "**/node_modules": true, "backend/oms-app/src/main/resources/static": true },
        "editor.formatOnSave": false,
        "eslint.workingDirectories": ["ui"],
        "[typescript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
        "[typescriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" }
      }
    },
    "codespaces": { "openFiles": ["docs/QUICKSTART.md"] }
  }
}
