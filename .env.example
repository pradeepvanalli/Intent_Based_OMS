# Intent OMS environment. Copy to .env (git-ignored) and fill in what you need.
# scripts/bootstrap.sh and docker-compose read this file. Every value here is a placeholder: never commit a real secret.
# Property names in brackets are the Spring properties the variables bind to (see docs/CONFIGURATION.md).

# ---------------------------------------------------------------------------------------------------------------------
# Database and cache
# ---------------------------------------------------------------------------------------------------------------------
# JDBC URL of PostgreSQL 16. docker-compose publishes Postgres on 5440 to avoid clashing with a local install.
OMS_DB_URL=jdbc:postgresql://localhost:5440/oms           # [spring.datasource.url]
OMS_DB_USER=oms                                            # [spring.datasource.username]
OMS_DB_PASSWORD=oms                                        # [spring.datasource.password]  change in production
OMS_DB_POOL=32                                             # [spring.datasource.hikari.maximum-pool-size]
# Redis for the shared promise cache (optional; Caffeine is used in-process when unset).
#OMS_REDIS_URL=redis://localhost:6379                      # [oms.sourcing.promise.redis-url]

# ---------------------------------------------------------------------------------------------------------------------
# HTTP and security
# ---------------------------------------------------------------------------------------------------------------------
OMS_PORT=8080                                              # [server.port]
# HS256 secret for locally issued session tokens. >= 32 random characters. Production refuses the default value.
OMS_JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters   # [oms.security.jwt-secret]
# Alternative to OMS_JWT_SECRET: a file whose content is the secret (Kubernetes/Docker secret mounts).
#OMS_JWT_SECRET_FILE=/run/secrets/oms-jwt                  # [oms.security.jwt-secret-file]
# Bootstrap users for local development: id:password:tenant:role1|role2, comma separated. MUST be empty in production;
# use OIDC or API keys instead. The default below seeds the demo tenant logins.
OMS_DEV_USERS=admin:admin:demo:admin,ops:ops:demo:ops_analyst,cs:cs:demo:cs_rep,risk:risk:demo:risk_analyst,finance:finance:demo:finance_controller,strategy:strategy:demo:strategy_lead
# Production mode: SPRING_PROFILES_ACTIVE=prod loads application-prod.yml and runs the fail-fast readiness check
# (random JWT secret, no dev users, no demo seed, explicit CORS, actuator limited to health/prometheus, master key set).
# docker-compose.prod.yml sets it for you. Outside the prod profile the same checks can be forced with:
#OMS_SECURITY_ENFORCE_PRODUCTION=true                      # [oms.security.enforce-production] (relaxed binding)
# AES-256 master key that envelope-encrypts per-tenant PII keys at rest (`openssl rand -base64 32` or a passphrase).
# Required in production.
#OMS_MASTER_KEY=                                           # [oms.security.master-key]
# Browser origins allowed to call the API (comma separated, https://). "*" is refused in production.
#OMS_CORS_ALLOWED_ORIGINS=https://oms.example.com          # [oms.security.cors.allowed-origins]
#OMS_CORS_ALLOW_CREDENTIALS=false                          # [oms.security.cors.allow-credentials]
# Swagger UI is off in production unless explicitly enabled.
#OMS_SWAGGER_ENABLED=false

# OIDC single sign-on (resource server). Enabled when either URI is set. Recipes for Keycloak, Entra ID and Okta are
# in docs/DEPLOYMENT.md "OIDC" and backend/oms-platform/HARDENING.md.
#OMS_OIDC_ISSUER_URI=https://login.example.com/realms/oms  # [oms.security.oidc.issuer-uri]
#OMS_OIDC_JWK_SET_URI=                                     # [oms.security.oidc.jwk-set-uri]
#OMS_OIDC_AUDIENCE=intent-oms                              # [oms.security.oidc.audience]
#OMS_OIDC_TENANT_CLAIM=tenant                              # [oms.security.oidc.tenant-claim]
#OMS_OIDC_DEFAULT_TENANT=acme                              # [oms.security.oidc.default-tenant]
#OMS_OIDC_ROLES_CLAIM=roles                                # [oms.security.oidc.roles-claim]
# Role mapping has no env placeholder; set it in a profile YAML or via relaxed binding, e.g.
#OMS_SECURITY_OIDC_ROLE_MAPPING_oms-admins=admin           # [oms.security.oidc.role-mapping.<idp role>=<oms role>]

# ---------------------------------------------------------------------------------------------------------------------
# AI providers (all optional: without keys the system runs in degraded mode on deterministic rules and defaults)
# ---------------------------------------------------------------------------------------------------------------------
# Option A: one OpenRouter key serves both Jev (L1 typed decisions) and the LLM (L2 reasoning).
#OPENROUTER_API_KEY=sk-or-v1-replace-me
# Model used for Jev through OpenRouter (default typesafe/jev-1.13) and the LLM model (default anthropic/claude-sonnet-4.5).
#JEV_MODEL=typesafe/jev-1.13                               # [oms.decision.jev.model]
#LLM_MODEL=anthropic/claude-sonnet-4.5                     # [oms.decision.llm.openai-model]

# Option B: direct provider keys.
#TYPESAFE_API_KEY=                                         # [oms.decision.jev.api-key]  Jev at https://api.typesafe.ai
#TYPESAFE_BASE_URL=                                        # [oms.decision.jev.base-url] override the Jev endpoint
#ANTHROPIC_API_KEY=                                        # [oms.decision.llm.anthropic-api-key]
#ANTHROPIC_MODEL=claude-sonnet-5                           # [oms.decision.llm.anthropic-model]
#OPENAI_API_KEY=                                           # [oms.decision.llm.openai-api-key]
#OPENAI_BASE_URL=                                          # [oms.decision.llm.openai-base-url] any OpenAI-compatible endpoint
#OPENAI_MODEL=                                             # [oms.decision.llm.openai-model]

# Copilot (oms-copilot): reuses OPENROUTER_API_KEY (preferred) or OPENAI_API_KEY; override with relaxed-binding names.
#OMS_COPILOT_ENABLED=true                                  # [oms.copilot.enabled]
#OMS_COPILOT_API_KEY=                                      # [oms.copilot.api-key]   defaults to OPENROUTER_API_KEY, then OPENAI_API_KEY
#OMS_COPILOT_MODEL=anthropic/claude-sonnet-4.5             # [oms.copilot.model]     gpt-5 when a direct OpenAI key is used
#OMS_COPILOT_BASE_URL=                                     # [oms.copilot.base-url]  auto by key prefix (OpenRouter / OpenAI)
#OMS_COPILOT_TEMPLATES_DIR=./config/copilot                # [oms.copilot.templates-dir] prompt templates (*.md)

# Provider selection and budgets.
#LLM_PROVIDER=auto                                         # [oms.decision.llm.provider] auto | anthropic | openai
#JEV_ENABLED=true                                          # [oms.decision.jev.enabled]
#JEV_TIMEOUT_MS=800                                        # [oms.decision.jev.timeout-ms]  GR-07 budget per call
#JEV_LATENCY_ALLOWANCE_MS=                                 # [oms.decision.jev.latency-allowance-ms] extra budget via a router (default 1200 on OpenRouter)
#LLM_TIMEOUT_MS=8000                                       # [oms.decision.llm.timeout-ms]

# ---------------------------------------------------------------------------------------------------------------------
# Demo data and configuration files
# ---------------------------------------------------------------------------------------------------------------------
# Seed the demo tenants on start: config, inventory and the sample orders of each folder. Set false in production.
OMS_DEMO_SEED=true                                         # [oms.demo.seed] also [oms.agent.demo-expose-secrets]
# Tenant folders under config/tenants the seeder loads (comma list). Each gets the dev users admin/ops/cs/risk/finance/
# strategy (password = user name) and appears on the login page. Folders that do not exist are skipped with a warning.
OMS_DEMO_TENANTS=demo,retail,electronics,apparel           # [oms.demo.tenants]
# Single-tenant fallback used only when OMS_DEMO_TENANTS is empty; scripts/new-tenant.sh documents using it.
#OMS_DEMO_TENANT=demo                                      # [oms.demo.tenant]
# Directory containing tenants/<tenant>/...  (relative paths resolve from the working directory).
#OMS_CONFIG_DIR=./config                                   # [oms.config-dir]

# ---------------------------------------------------------------------------------------------------------------------
# Payments and integrations
# ---------------------------------------------------------------------------------------------------------------------
#OMS_FINANCE_PSP=mock                                      # [oms.finance.psp] mock | stripe
#OMS_FINANCE_STRIPE_API_KEY=                               # [oms.finance.stripe.api-key]
#OMS_FINANCE_TAX=flat                                      # [oms.finance.tax] flat | avalara
#OMS_KAFKA_ENABLED=false                                   # [oms.kafka.enabled] publish ledger events to Kafka
#KAFKA_BOOTSTRAP=localhost:9092                            # [spring.kafka.bootstrap-servers]

# ---------------------------------------------------------------------------------------------------------------------
# Connectors (oms-integrations). All off by default: deterministic mocks keep the system running without credentials.
# GET /api/v1/integrations/status shows what is active. Tenant-level endpoints and secrets (wms.*, marketplace.*,
# carrier.easypost.webhook_secret, notify.*) are set through PUT /api/v1/admin/config/{key}, not here.
# ---------------------------------------------------------------------------------------------------------------------
#OMS_GRAPHIQL=false                                        # [oms.integrations.graphiql] GraphiQL at /graphiql (dev only); POST /graphql is always on
#OMS_NOTIFY_ENABLED=false                                  # [oms.integrations.notify.enabled] SendGrid / Twilio customer messages
#SENDGRID_API_KEY=                                         # [oms.integrations.notify.sendgrid.api-key]
#SENDGRID_FROM_EMAIL=orders@example.com                    # [oms.integrations.notify.sendgrid.from-email]
#SENDGRID_FROM_NAME=Intent OMS                             # [oms.integrations.notify.sendgrid.from-name]
#TWILIO_ACCOUNT_SID=                                       # [oms.integrations.notify.twilio.account-sid]
#TWILIO_AUTH_TOKEN=                                        # [oms.integrations.notify.twilio.auth-token]
#TWILIO_FROM=+15550000000                                  # [oms.integrations.notify.twilio.from]
#OMS_ADDRESS_PROVIDER=mock                                 # [oms.integrations.address.provider] mock | smarty
#SMARTY_AUTH_ID=                                           # [oms.integrations.address.smarty.auth-id]
#SMARTY_AUTH_TOKEN=                                        # [oms.integrations.address.smarty.auth-token]
#OMS_CARRIER_PROVIDER=mock                                 # [oms.integrations.carrier.provider] mock | easypost
#EASYPOST_API_KEY=                                         # [oms.integrations.carrier.easypost.api-key]
#OMS_WMS_PROVIDER=mock                                     # [oms.integrations.wms.provider] mock | http (release URLs are tenant keys wms.*)
#AMAZON_SPAPI_ENABLED=false                                # [oms.integrations.marketplace.amazon.enabled] SP-API order poller
#AMAZON_SPAPI_CLIENT_ID=                                   # [oms.integrations.marketplace.amazon.client-id]  (LWA)
#AMAZON_SPAPI_CLIENT_SECRET=                               # [oms.integrations.marketplace.amazon.client-secret]
#AMAZON_SPAPI_REFRESH_TOKEN=                               # [oms.integrations.marketplace.amazon.refresh-token]
#AMAZON_SPAPI_MARKETPLACE_IDS=ATVPDKIKX0DER                # [oms.integrations.marketplace.amazon.marketplace-ids] comma separated

# ---------------------------------------------------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------------------------------------------------
#OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces   # [management.otlp.tracing.endpoint]
#OTEL_SAMPLING=0.1                                         # [management.tracing.sampling.probability]

# ---------------------------------------------------------------------------------------------------------------------
# Local tooling (not read by the application)
# ---------------------------------------------------------------------------------------------------------------------
# JDK 21 home for the Makefile and scripts when `java` on PATH is not 21.
#JAVA_HOME=/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home
# Tests: reuse a database instead of Testcontainers (see CONTRIBUTING.md).
#OMS_TEST_JDBC_URL=jdbc:postgresql://localhost:5440/oms_test
#OMS_TEST_JDBC_USER=oms
#OMS_TEST_JDBC_PASSWORD=oms
